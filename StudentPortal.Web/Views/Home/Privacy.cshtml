@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-2">
    <div class="mb-4">
        <h1 class="display-5 fw-bold text-primary mb-2">@ViewData["Title"]</h1>
        <p class="text-muted fs-5">Use this page to detail your site's privacy policy.</p>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4 p-md-5">
            <section class="mb-4">
                <h2 class="h5 fw-bold mb-3">1. Student Information & Data Access</h2>
                <p class="text-muted">
                    StudentPortal stores and manages academic and personal data strictly for enrollment tracking, grading, and administrative workflows. Access to these records is constrained to authorized accounts.
                </p>
            </section>

            <hr class="my-4">

            <section class="mb-4">
                <h2 class="h5 fw-bold mb-3">2. System Protection</h2>
                <p class="text-muted">
                    All forms and authentication operations are protected using HTTPS and standard server-side validation to prevent unauthorized record manipulation.
                </p>
            </section>

            <hr class="my-4">

            <section>
                <h2 class="h5 fw-bold mb-3">3. Contact Support</h2>
                <p class="text-muted mb-0">
                    If you have questions regarding data retention or user privileges, contact the administrator directly.
                </p>
            </section>
        </div>
    </div>


</div>